            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"StateList\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"s3:ListBucket\",\n      \"Resource\": \"arn:aws:s3:::oficina-mecanica-tfstate-881757053222\",\n      \"Condition\": {\n        \"StringLike\": {\n          \"s3:prefix\": \"prod/os-service/*\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"StateObject\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"s3:PutObject\",\n        \"s3:GetObject\",\n        \"s3:DeleteObject\"\n      ],\n      \"Resource\": \"arn:aws:s3:::oficina-mecanica-tfstate-881757053222/prod/os-service/*\"\n    },\n    {\n      \"Sid\": \"StateLock\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"dynamodb:PutItem\",\n        \"dynamodb:GetItem\",\n        \"dynamodb:DescribeTable\",\n        \"dynamodb:DeleteItem\"\n      ],\n      \"Resource\": \"arn:aws:dynamodb:sa-east-1:881757053222:table/oficina-mecanica-tflock\"\n    },\n    {\n      \"Sid\": \"ReadOnly\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"sts:GetCallerIdentity\",\n        \"ssm:DescribeParameters\",\n        \"elasticloadbalancing:Describe*\",\n        \"eks:ListClusters\",\n        \"eks:DescribeCluster\",\n        \"ecr:GetAuthorizationToken\",\n        \"ec2:Describe*\"\n      ],\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"Image\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"ecr:*\",\n      \"Resource\": \"arn:aws:ecr:sa-east-1:881757053222:repository/oficina-mecanica/prod/os-service\"\n    },\n    {\n      \"Sid\": \"Contract\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"ssm:RemoveTagsFromResource\",\n        \"ssm:PutParameter\",\n        \"ssm:ListTagsForResource\",\n        \"ssm:GetParameters\",\n        \"ssm:GetParameter\",\n        \"ssm:DeleteParameter\",\n        \"ssm:AddTagsToResource\"\n      ],\n      \"Resource\": \"arn:aws:ssm:sa-east-1:881757053222:parameter/oficina-mecanica/prod/os_*\"\n    },\n    {\n      \"Sid\": \"Messaging\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"sqs:*\",\n        \"sns:*\"\n      ],\n      \"Resource\": [\n        \"arn:aws:sqs:sa-east-1:881757053222:oficina-prod-os-*\",\n        \"arn:aws:sns:sa-east-1:881757053222:oficina-prod-os-*\"\n      ]\n    },\n    {\n      \"Sid\": \"Secrets\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"secretsmanager:*\",\n      \"Resource\": \"arn:aws:secretsmanager:sa-east-1:881757053222:secret:oficina-mecanica/prod/os-service*\"\n    },\n    {\n      \"Sid\": \"SharedSecrets\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"secretsmanager:GetSecretValue\",\n        \"secretsmanager:DescribeSecret\"\n      ],\n      \"Resource\": [\n        \"arn:aws:secretsmanager:sa-east-1:881757053222:secret:oficina-mecanica/prod/internal-service-token-??????\",\n        \"arn:aws:secretsmanager:sa-east-1:881757053222:secret:oficina-mecanica-prod/jwt-secret-??????\"\n      ]\n    },\n    {\n      \"Sid\": \"ServiceRole\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"iam:UpdateRole\",\n        \"iam:UpdateAssumeRolePolicy\",\n        \"iam:UntagRole\",\n        \"iam:TagRole\",\n        \"iam:PutRolePolicy\",\n        \"iam:ListRolePolicies\",\n        \"iam:ListInstanceProfilesForRole\",\n        \"iam:ListAttachedRolePolicies\",\n        \"iam:GetRolePolicy\",\n        \"iam:GetRole\",\n        \"iam:DeleteRolePolicy\",\n        \"iam:DeleteRole\",\n        \"iam:CreateRole\"\n      ],\n      \"Resource\": \"arn:aws:iam::881757053222:role/oficina-prod-os*\"\n    },\n    {\n      \"Sid\": \"Network\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"ec2:UpdateSecurityGroupRuleDescriptionsIngress\",\n        \"ec2:UpdateSecurityGroupRuleDescriptionsEgress\",\n        \"ec2:RevokeSecurityGroupIngress\",\n        \"ec2:RevokeSecurityGroupEgress\",\n        \"ec2:ModifySecurityGroupRules\",\n        \"ec2:D