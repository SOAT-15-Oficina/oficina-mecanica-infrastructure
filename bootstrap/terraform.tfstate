            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"StateList\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"s3:ListBucket\",\n      \"Resource\": \"arn:aws:s3:::oficina-mecanica-tfstate-881757053222\",\n      \"Condition\": {\n        \"StringLike\": {\n          \"s3:prefix\": \"prod/execution-service/*\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"StateObject\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"s3:PutObject\",\n        \"s3:GetObject\",\n        \"s3:DeleteObject\"\n      ],\n      \"Resource\": \"arn:aws:s3:::oficina-mecanica-tfstate-881757053222/prod/execution-service/*\"\n    },\n    {\n      \"Sid\": \"StateLock\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"dynamodb:PutItem\",\n        \"dynamodb:GetItem\",\n        \"dynamodb:DescribeTable\",\n        \"dynamodb:DeleteItem\"\n      ],\n      \"Resource\": \"arn:aws:dynamodb:sa-east-1:881757053222:table/oficina-mecanica-tflock\"\n    },\n    {\n      \"Sid\": \"ReadOnly\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"sts:GetCallerIdentity\",\n        \"ssm:DescribeParameters\",\n        \"elasticloadbalancing:Describe*\",\n        \"eks:ListClusters\",\n        \"eks:DescribeCluster\",\n        \"ecr:GetAuthorizationToken\",\n        \"ec2:Describe*\"\n      ],\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"Image\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"ecr:*\",\n      \"Resource\": \"arn:aws:ecr:sa-east-1:881757053222:repository/oficina-mecanica/prod/execution-service\"\n    },\n    {\n      \"Sid\": \"Contract\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"ssm:RemoveTagsFromResource\",\n        \"ssm:PutParameter\",\n        \"ssm:ListTagsForResource\",\n        \"ssm:GetParameters\",\n        \"ssm:GetParameter\",\n        \"ssm:DeleteParameter\",\n        \"ssm:AddTagsToResource\"\n      ],\n      \"Resource\": \"arn:aws:ssm:sa-east-1: